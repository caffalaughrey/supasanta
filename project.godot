; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Supa Santa"
run/main_scene="res://scenes/World.tscn"
config/features=PackedStringArray("4.5")
config/icon="res://icon.svg"

[autoload]

InputSetup="*res://scripts/autoload/input_setup.gd"
TestBoot="*res://scripts/tests/smoke/TestBoot.gd"
InputDebug="*res://scripts/autoload/input_debug.gd"
UnitBoot="*res://scripts/tests/unit/UnitBoot.gd"

[rendering]

environment/default_environment="res://default_env.tres"
